diff --git a/src/sysBootup.cpp b/src/sysBootup.cpp
index 985997c..53e9884 100644
--- a/src/sysBootup.cpp
+++ b/src/sysBootup.cpp
@@ -5,11 +5,59 @@
 /**
  * @todo: Documentation
  */
+#if defined(TARGET_PC)
+#include <cstdlib>
+extern "C" void pc_card_selftest(void);          // pc_card.cpp
+extern "C" void pc_crash_handler_install(void);  // pc_crash.cpp
+extern "C" void pc_input_early_init(void);       // pc_input_rec.cpp
+extern "C" void pc_uninit_arm(void);              // pc_uninit.cpp
+extern "C" void pc_sync_startup(void);           // pc_sync.cpp
+#endif
+
 TERNARY_BUILD_MATCHING(void, int) main(int argc, char* argv[])
 {
+#if defined(TARGET_PC)
+	// First thing, before anything can fault: real gameplay crashes can only
+	// be found by a human (headless input cannot play), so the binary reports
+	// its own backtrace rather than needing a re-run under lldb. Allocates
+	// nothing — see pc_crash.cpp.
+	pc_crash_handler_install();
+	// Replay needs a fixed timestep, and system.cpp caches PC_FIXED_DT on its
+	// first read — so the default has to be set before the game loop starts.
+	// Touches only the environment; allocates nothing.
+	pc_input_early_init();
+	// PC_UNINIT_PROBE=1: arm the -Wconditional-uninitialized probe here rather
+	// than on its first hit, so "no site was reached" is a REPORTED result and
+	// not indistinguishable from "the probe was never wired up". Reads one
+	// environment variable and calls atexit; allocates nothing.
+	pc_uninit_arm();
+#endif
+#if defined(TARGET_PC)
+	// PC_CARD_SELFTEST=1: exercise the memory-card shim and exit, without
+	// booting the game (pc_card.cpp).
+	if (getenv("PC_CARD_SELFTEST")) {
+		pc_card_selftest();
+		exit(0);
+	}
+	// Save sync (settings.ini [sync]; off unless configured). Must run BEFORE
+	// the game can mount the memory card: reconciling afterwards would mean
+	// the game had already loaded the old save and then had the file replaced
+	// underneath it. Blocking, but with a short timeout — an unreachable
+	// server costs a few seconds and drops to offline. No-op when unset.
+	pc_sync_startup();
+#endif
 	gsys->Initialise();
 	nodeMgr = new NodeMgr();
 	gsys->run(new PlugPikiApp());
 
 	OSErrorLine(29, "End of demo");
+#if defined(TARGET_PC)
+	// Falling off the end is legal for main() ONLY — the standard gives main an
+	// implicit `return 0`. The iOS build renames this function to SDL_main
+	// (-Dmain=SDL_main, so SDL2's UIKit backend can own UIApplicationMain),
+	// which loses that exemption: without this the return value is register
+	// residue and -Werror=return-type rejects the TU. Guarded because the
+	// matching build's return type is void.
+	return 0;
+#endif
 }
