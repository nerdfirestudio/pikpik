+typedef struct PPCWGPipe {
+	// ::-qualified param types: inside the struct, bare u8/f32 etc. find the
+	// sibling members (injected names), not the global typedefs.
+	struct { void operator=(::u8 v) volatile { pc_gx_fifo_u8(v); } } u8;
+	struct { void operator=(::s8 v) volatile { pc_gx_fifo_s8(v); } } s8;
+	struct { void operator=(::u16 v) volatile { pc_gx_fifo_u16(v); } } u16;
